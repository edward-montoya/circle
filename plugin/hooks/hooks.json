{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "circle session start --hook",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "circle gate check --hook",
            "timeout": 15,
            "statusMessage": "circle: checking contracts"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "circle event record --type skill.run --hook",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "circle domain sync --hook",
            "timeout": 20,
            "statusMessage": "circle: updating the domain index"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "circle event record --type tool.use",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": "package.json|Makefile|pyproject.toml|docker-compose.yml|go.mod",
        "hooks": [
          {
            "type": "command",
            "command": "circle project validate --quiet",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "circle task close --verify-only",
            "timeout": 30
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "circle worktree provision --hook",
            "timeout": 30,
            "statusMessage": "circle: isolating the compose stack"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "circle worktree release --hook",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "circle event record --type skill.run --hook",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
