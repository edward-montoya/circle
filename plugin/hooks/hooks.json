{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "circle timeline open --item default", "timeout": 15, "async": true } ] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|NotebookEdit",
        "hooks": [ { "type": "command", "command": "circle gate check --hook", "timeout": 15, "statusMessage": "circle: checking contracts" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Bash",
        "hooks": [ { "type": "command", "command": "circle event record --type tool.use", "timeout": 10, "async": true } ] }
    ],
    "FileChanged": [
      { "matcher": "package.json|Makefile|pyproject.toml|docker-compose.yml|go.mod",
        "hooks": [ { "type": "command", "command": "circle project validate --quiet", "timeout": 20, "async": true } ] }
    ],
    "TaskCompleted": [
      { "hooks": [ { "type": "command", "command": "circle task close --verify-only", "timeout": 30 } ] }
    ]
  }
}
